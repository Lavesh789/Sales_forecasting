        "outlier_summary = {}\n",
        "for column in numeric_cols:\n",
        "    Q1 = df[column].quantile(0.25)\n",
        "    Q3 = df[column].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    lower_limit = Q1 - 1.5 * IQR\n",
        "    upper_limit = Q3 + 1.5 * IQR\n",
        "    outliers = df[\n",
        "        (df[column] < lower_limit) |(df[column] > upper_limit)\n",
        "    ]\n",
        "\n",
